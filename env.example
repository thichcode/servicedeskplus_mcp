# ServiceDesk Plus Cloud API Configuration
# Reference: https://www.manageengine.com/products/service-desk/sdpop-v3-api/
# Copy this file to .env and fill in your actual values

# Base URL of your ServiceDesk Plus Cloud instance
# Example: https://yourdomain.service-deskplus.com
SDP_BASE_URL=https://your-servicedesk-plus-instance.com

# API Key for authentication
# Generate from: Admin -> Technicians/Users -> Edit user -> Generate API Key
# The API Key is passed via 'authtoken' header
SDP_API_KEY=your_api_key_here
