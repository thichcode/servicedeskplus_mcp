# ServiceDesk Plus API Configuration
# Supports both Cloud and On-Premise API v3
# Copy this file to .env and fill in your actual values

# Base URL of your ServiceDesk Plus instance
# Example Cloud: https://yourdomain.service-deskplus.com
# Example On-Premise: https://localhost:8080
SDP_BASE_URL=https://localhost:8080

# API Key for authentication
# Cloud: Uses 'authtoken' header
# On-Premise: Uses 'Authtoken' header (capital A) + session cookie
SDP_API_KEY=your_api_key_here

# API Type: "cloud" or "onpremise"
SDP_API_TYPE=onpremise

# On-Premise only: Admin credentials for session login
# Required for SDP On-Premise v14.x which needs both session + Authtoken
SDP_USERNAME=administrator
SDP_PASSWORD=
